<Window x:Class="Gutenkern.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gutenkern"
        Icon="AppIcon.ico"
        Width="760"
        Height="760"
        MinWidth="720"
        MinHeight="640"
        Background="White"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="FieldBackgroundBrush" Color="#FCFCFC"/>
        <SolidColorBrush x:Key="FieldBorderBrush" Color="#F2F2F2"/>
        <Style x:Key="FieldBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource FieldBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource FieldBackgroundBrush}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem x:Name="FileMenuItem" Header="File">
                <MenuItem x:Name="UndoMenuItem"
                          Header="Undo"
                          Click="UndoMarks_Click"
                          InputGestureText="Ctrl+Z"/>
                <MenuItem x:Name="RedoMenuItem"
                          Header="Redo"
                          Click="RedoMarks_Click"
                          InputGestureText="Ctrl+Shift+Z"/>
                <Separator/>
                <MenuItem x:Name="SaveMenuItem"
                          Header="Save"
                          Command="Save"
                          InputGestureText="Ctrl+S"/>
            </MenuItem>
            <MenuItem x:Name="SettingsMenuItem" Header="Settings">
                <MenuItem x:Name="SettingsWindowMenuItem"
                          Header="Settings"
                          Click="SettingsButton_Click"
                          InputGestureText="Ctrl+,"/>
                <Separator/>
                <MenuItem x:Name="FormatFontLabMenu"
                          Header="FontLab"
                          IsCheckable="True"
                          Click="FormatMenu_Click"/>
                <MenuItem x:Name="FormatGlyphsMenu"
                          Header="Glyphs"
                          IsCheckable="True"
                          Click="FormatMenu_Click"/>
                <Separator/>
                <MenuItem x:Name="ResetProgressMenu"
                          Header="Reset progress"
                          Click="ResetProgress_Click"/>
            </MenuItem>
            <MenuItem x:Name="HelpMenuItem" Header="Help">
                <MenuItem x:Name="AboutMenuItem"
                          Header="About Gutenkern"
                          Click="AboutButton_Click"/>
            </MenuItem>
        </Menu>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="WhatLabel"
                       Grid.Row="0"
                       Grid.Column="0"
                       Text="Glyphs"
                       FontWeight="SemiBold"
                       VerticalAlignment="Top"
                       Margin="0,0,20,0"/>
            <Border Grid.Row="0"
                    Grid.Column="1"
                    Height="100"
                    Style="{StaticResource FieldBorder}">
                <RichTextBox x:Name="Field1"
                             AcceptsReturn="True"
                             AcceptsTab="False"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             SpellCheck.IsEnabled="False"
                             FontSize="13"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="6,4"
                             TextChanged="FieldsChanged"/>
            </Border>

            <StackPanel Grid.Row="2"
                        Grid.Column="0"
                        VerticalAlignment="Top"
                        Margin="0,0,20,0">
                <TextBlock x:Name="ResultLabel"
                           Text="Result"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="TotalPairCount"
                           FontSize="13"
                           Margin="0,4,0,0"
                           Visibility="Collapsed"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                <StackPanel x:Name="CategoryNav"
                            Margin="0,20,0,0"/>
            </StackPanel>
            <Border Grid.Row="2"
                    Grid.Column="1"
                    Style="{StaticResource FieldBorder}"
                    ClipToBounds="True">
                <Grid>
                    <RichTextBox x:Name="ResultBox"
                                 IsReadOnly="True"
                                 IsUndoEnabled="False"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 SpellCheck.IsEnabled="False"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="6,4"
                                 ContextMenuOpening="Result_ContextMenuOpening"/>
                    <TextBlock x:Name="ResultPlaceholder"
                               IsHitTestVisible="False"
                               Margin="6,4"
                               FontFamily="Consolas"
                               FontSize="13"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="4"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button x:Name="SaveButton"
                        Content="Save all pairs..."
                        Padding="16,6"
                        Click="SaveButton_Click"
                        IsEnabled="False"/>
                <Button x:Name="SaveAndOpenButton"
                        Content="Save all and open..."
                        Padding="16,6"
                        Margin="10,0,0,0"
                        Click="SaveAndOpen_Click"
                        IsEnabled="False"/>
                <Button x:Name="CopyAllButton"
                        Content="Copy all"
                        Padding="16,6"
                        Margin="10,0,0,0"
                        Click="CopyAll_Click"
                        IsEnabled="False"
                        Background="#00AAFF"
                        Foreground="White"
                        BorderBrush="#00AAFF">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="3"
                                    Opacity="{TemplateBinding Opacity}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <Border x:Name="CopiedToast"
                    Grid.Row="0"
                    Grid.RowSpan="5"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,8"
                    Padding="16,10"
                    CornerRadius="16"
                    Background="#C7000000"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"
                    Panel.ZIndex="10">
                <TextBlock x:Name="CopiedToastText"
                           Foreground="White"
                           FontSize="13"/>
            </Border>
        </Grid>
    </DockPanel>
</Window>
